# MySQL connection (Prisma)
DATABASE_URL="mysql://USER:PASSWORD@localhost:3306/rjapc_db"

# JWT secret for admin sessions (use a long random string in production)
JWT_SECRET="change-this-to-a-long-random-secret-in-production"

# Default admin (created by seed if not exists)
ADMIN_EMAIL="admin@rjapc.org"
ADMIN_PASSWORD="change-me-after-first-login"

# Public site URL (for metadata)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# WhatsApp (full international number, no +). Site default is 918005909134 if unset.
NEXT_PUBLIC_WHATSAPP_NUMBER="918005909134"

# Social links (optional — icons use CMS contact JSON first, then these env vars)
NEXT_PUBLIC_INSTAGRAM_URL="https://www.instagram.com/your-org"
NEXT_PUBLIC_FACEBOOK_URL="https://www.facebook.com/your-page"
NEXT_PUBLIC_X_URL="https://x.com/your-handle"
NEXT_PUBLIC_YOUTUBE_URL="https://www.youtube.com/@your-channel"
NEXT_PUBLIC_LINKEDIN_URL="https://www.linkedin.com/company/your-org"
